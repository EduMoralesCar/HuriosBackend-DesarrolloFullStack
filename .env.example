# ==============================================================================
# HURIOS RALLY BACKEND - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como ".env" en la raiz del backend y completa tus valores.
# El archivo ".env" esta en .gitignore y nunca se subira a GitHub.

# --- Base de datos No Relacional (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/hurios_rally?retryWrites=true&w=majority

# --- Pasarela de Pagos MercadoPago (Credenciales de Prueba / Sandbox) ---
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_WEBHOOK_URL=

# --- Frontend & CORS ---
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seguridad JWT ---
JWT_SECRET=dev-secret-key-for-hurios-rally-2026-jwt-token
JWT_EXPIRATION_MINUTES=120

# --- Correo SMTP / Resend (Opcional) ---
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_API_KEY=

# --- Supabase Storage & Gemini API (Opcional) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hurios-media
GEMINI_API_KEY=
